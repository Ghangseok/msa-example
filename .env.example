# 로컬 실행 인프라의 비밀값 목록. 값은 적지 않는다.
#
# 쓰는 법: 저장소 루트에서 복사한 뒤 값을 채운다.
#   Copy-Item .env.example .env
# .env는 저장소에 올리지 않는다(.gitignore). 이 저장소는 공개 저장소다.
#
# - Oracle 비밀번호에는 영문자와 숫자만 쓴다. @ / " 같은 문자는 접속 문자열을 깨뜨린다.
# - Oracle 비밀번호는 DB를 처음 만들 때만 쓰인다. 나중에 값만 바꾸면 DB와 어긋난다.
#   바꾸려면 데이터 볼륨을 지우고(tools/infra-down.ps1 -RemoveData) 다시 띄운다.

# order-db의 SYS, SYSTEM 비밀번호
ORDER_DB_ADMIN_PASSWORD=
# order-db의 서비스 계정 ORDER_SVC 비밀번호 (XEPDB1)
ORDER_SVC_PASSWORD=

# inventory-db의 SYS, SYSTEM 비밀번호
INVENTORY_DB_ADMIN_PASSWORD=
# inventory-db의 서비스 계정 INVENTORY_SVC 비밀번호 (XEPDB1)
INVENTORY_SVC_PASSWORD=

# Keycloak 관리 콘솔(http://localhost:8180/admin)의 관리자 admin 비밀번호
KEYCLOAK_ADMIN_PASSWORD=

# realm msa의 테스트 사용자 비밀번호 (c1, c2: CUSTOMER / m1: ADMIN)
C1_PASSWORD=
C2_PASSWORD=
M1_PASSWORD=
